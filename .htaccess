# Page d'accueil = la garde (pas la carte index.html)
DirectoryIndex bienvenue.html

# Revalidation obligatoire du code, des pages et des données.
# Sans en-tête, le navigateur applique une fraîcheur « au jugé » et peut garder
# des heures un fichier corrigé — y compris en le rendant au service worker.
# L'ETag rend la revalidation quasi gratuite : 304 si rien n'a changé.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|geojson)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Interdire l'accès aux dossiers de versionnage ─────────────────────────
# Un dépôt Git servi sur une racine web se reconstitue en entier : /.git/config
# donne le dépôt d'origine, /.git/index et les objets rendent tout l'historique,
# y compris ce qui en a été retiré depuis. Sept éditions l'exposaient le 16/08/2026.
# La règle ci-dessous ferme la porte même si un envoi y redépose le dossier.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(git|svn|hg)(/|$) - [F,L]
</IfModule>
<FilesMatch "^\.(git|gitignore|gitattributes|env)">
  Require all denied
</FilesMatch>
